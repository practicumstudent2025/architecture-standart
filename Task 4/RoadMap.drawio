        <!-- Технические критерии -->
        <mxCell id="tech_criteria" value="Технические критерии:&#xa;• Время обновления ставок < 5 минут&#xa;• Доступность системы 99.5%&#xa;• Успешная передача 99% файлов&#xa;• Отсутствие утечек данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
